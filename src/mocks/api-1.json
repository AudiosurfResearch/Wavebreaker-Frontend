						"description": "Miscellaneous error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SimpleRouteErrorOutput"
								}
							}
						}
					}
				},
				"security": [
					{
						"token_jwt": []
					}
				]
			}
		},
