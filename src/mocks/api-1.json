					"200": {
						"description": "Logout successful",
						"content": {
							"application/json": {
								"schema": {
									"default": null
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SimpleRouteErrorOutput"
								}
							}
						}
					},
