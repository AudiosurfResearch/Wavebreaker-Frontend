{
	"name": "wavebreaker-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check",
		"check:fix": "biome check --write",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && biome lint && eslint .",
		"lint:fix": "biome lint --write",
		"fmt": "biome format --write",
		"fmt:check": "biome format",
		"update-openapi": "openapi-typescript ./src/lib/api/api-1.json -o ./src/lib/api/v1.d.ts --enum",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@deno/svelte-adapter": "^0.2.1",
		"@fontsource-variable/inter": "^5.2.8",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.16.0",
		"openapi-types": "^12.1.3",
		"vite": "^7.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.563.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^24.13.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.61.1"
	}
}
