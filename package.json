{
	"name": "wavebreaker-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check",
		"check:fix": "biome check --write",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && biome lint && eslint .",
		"lint:fix": "biome lint --write",
		"fmt": "biome format --write",
		"fmt:check": "biome format",
		"update-openapi": "openapi-typescript ./src/lib/api/api-1.json -o ./src/lib/api/v1.d.ts --enum",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.16.0",
		"openapi-types": "^12.1.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.2",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.563.1",
		"@storybook/addon-a11y": "^10.3.6",
		"@storybook/addon-docs": "^10.3.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.6",
		"@storybook/sveltekit": "^10.3.6",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.5",
		"@vitest/coverage-v8": "^4.1.5",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.6",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"openapi-typescript": "^7.10.1",
		"oxfmt": "^0.28.0",
		"oxlint": "^1.43.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"storybook": "^10.3.6",
		"svelte": "^5.45.6",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.3.4",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.1",
		"vite": "^7.2.6",
		"vitest": "^4.1.5"
	},
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
